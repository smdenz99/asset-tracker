# Copy to .env and adjust. Every setting is optional.

# Port and network interface. 0.0.0.0 lets other computers and phones connect.
PORT=3000
HOST=0.0.0.0

# Where the SQLite database lives.
DATA_DIR=./data

# Printed at the top of every label.
ORG_NAME=IT Asset

# New tags are TAG_PREFIX followed by a zero-padded number, e.g. IT-00001.
TAG_PREFIX=IT-
TAG_DIGITS=5

# HTTPS. Phones only allow live camera scanning over HTTPS.
# HTTPS_CERT=./certs/server.pem
# HTTPS_KEY=./certs/server-key.pem

# Behind a reverse proxy (IIS, nginx, Caddy) that handles HTTPS instead:
# TRUST_PROXY=1
# SECURE_COOKIES=1

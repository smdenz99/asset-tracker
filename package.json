{
  "name": "asset-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "IT asset tracking with barcode scanning for small IT teams",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "backup": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/backup.js",
    "test":"node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@zxing/library": "0.21.3",
    "express": "^5.1.0",
    "jsbarcode": "3.11.6"
  }
}
